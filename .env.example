# Swiss Case Law Web UI — Environment Configuration
# Copy to .env and fill in your API keys.

# ── LLM Providers (at least one required) ────────────────────
# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Google Gemini
GEMINI_API_KEY=AI...
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude
# NOTE: This requires an Anthropic API key from console.anthropic.com.
#       A Claude Desktop / Claude Pro subscription does NOT provide an API key.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ── PA-RAG / Summary-Augmented Chunking ──────────────────────
# synthetic.new provides OpenAI-compatible access to OSS reasoning models
# (Qwen3-Thinking, Kimi-K2-Thinking, GLM-4.5 Thinking, etc.). Used by the
# PA-RAG enrichment pipeline (Phase 3 SAC + Phase 5 metadata extraction).
SYNTHETIC_API_KEY=syn_...
SYNTHETIC_BASE_URL=https://api.synthetic.new/v1
# Default model for SAC summary headers and chunk classification.
# Alternates: moonshotai/Kimi-K2-Thinking, zai-org/GLM-4.5 (when available).
SYNTHETIC_MODEL=hf:Qwen/Qwen3-235B-A22B-Thinking-2507
# Fallback model used when the primary returns an error or times out.
SYNTHETIC_FALLBACK_MODEL=hf:moonshotai/Kimi-K2-Thinking

# ── Backend ──────────────────────────────────────────────────
BACKEND_PORT=8910
FRONTEND_PORT=5173

# ── MCP Server ───────────────────────────────────────────────
# Path to the MCP server script (auto-detected if in same repo)
# MCP_SERVER_PATH=/path/to/mcp_server.py

# Python executable for MCP subprocess
# MCP_PYTHON=python3

# Tool call timeout in seconds
# MCP_TOOL_TIMEOUT=120

# ── Database ─────────────────────────────────────────────────
# Override default database directory (~/.swiss-caselaw)
# SWISS_CASELAW_DIR=/path/to/data

# ── PA-RAG Phase 5 enrichment (OpenRouter) ────────────────────
# Cost-efficient Gemini via OpenRouter for per-decision metadata extraction
# (sort, principle_questions, doctrine, prior_case_treatment). See
# scripts/parag/benchmark_models_phase5.py for model comparison rationale.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash
