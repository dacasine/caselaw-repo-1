# Copy to .env and edit before first `docker compose up`.
# Strong random passwords; rotate via `openssl rand -base64 24`.

# ── Primary DB (caselaw) ──────────────────────────────────────
PG_CASELAW_USER=caselaw
PG_CASELAW_PASSWORD=CHANGE_ME_STRONG_CASELAW

# ── Secondary DB (doctrine) ───────────────────────────────────
PG_DOCTRINE_USER=doctrine
PG_DOCTRINE_PASSWORD=CHANGE_ME_STRONG_DOCTRINE

# ── Public hostname (for Caddy + Let's Encrypt) ───────────────
# Set to your real domain before deploying!
PUBLIC_HOST=caselaw.tondomaine.ch
